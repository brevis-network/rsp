index 00000000..ae881b05
--- /dev/null
+++ b/crates/evm2/src/bytecode/analysis/riscv64.rs
@@ -0,0 +1,119 @@
+//! Jump destination analysis for riscv64, where the analysis is proved as well as run.
+//!
+//! The scalar loop asks three things of every instruction of the code, each with a branch: is it
+//! a `JUMPDEST`, is it a `PUSH`, is the code over. On riscv64 that is five or six instructions
+//! of the machine, three of them branches, and a zkVM proves a comparison for every branch. The
+//! analysis of a block's codes is then the stretch of a guest's run with the largest share of
+//! them.
+//!
+//! This loop takes the length of an instruction from a table, in which `JUMPDEST` is the one
+//! entry to stop for, and looks for the end of the code once in eight instructions. That is a
+//! branch and an eighth for an instruction of the code, in as many instructions of the machine
+//! as before.
+
+use crate::interpreter::op;
+
+/// The length of the instruction that starts with each byte: one, or two to 33 for `PUSH1` to
+/// `PUSH32`. Zero for `JUMPDEST`, which is one byte long and is the instruction to stop at.
+static LENGTHS: [u8; 256] = {
+    let mut lengths = [1; 256];
+    let mut push = op::PUSH1;
+    while push <= op::PUSH32 {
+        lengths[push as usize] = push - op::PUSH1 + 2;
+        push += 1;
+    }
+    lengths[op::JUMPDEST as usize] = 0;
+    lengths
+};
+
+/// The instructions the loop passes between two looks at the end of the code.
+const UNROLLED: usize = 8;
+
+/// How far past the first of them the last of them can start: each is at most a `PUSH32`.
+const REACH: usize = (UNROLLED - 1) * 33;
+
+/// Marks the jump destinations of `code` up to the last [`REACH`] bytes, and returns the offset of
+/// the first instruction it did not pass.
+#[inline]
+pub(super) fn analyze(code: &[u8], table: &mut [u8]) -> usize {
+    let Some(bulk) = code.len().checked_sub(REACH) else {
+        return 0;
+    };
+    let start = code.as_ptr();
+    // SAFETY: `bulk` is at most the length of `code`.
+    let bulk_end = unsafe { start.add(bulk) };
+    let mut pc = start;
+    while pc < bulk_end {
+        for _ in 0..UNROLLED {
+            // SAFETY: The first instruction starts before `bulk_end`, so the ones after it start
+            // at most `REACH` bytes later, which is inside `code`. `table` has a bit for each
+            // byte of `code`.
+            pc = unsafe { pass(pc, start, table) };
+        }
+    }
+    // A PUSH can leave this past the end of the code, as it can the scalar loop.
+    pc.addr() - start.addr()
+}
+
+/// Passes the instruction at `pc`, marking it in `table` if it is a `JUMPDEST`.
+///
+/// # Safety
+///
+/// `pc` must be inside the code that starts at `start`, and `table` must have a bit for each byte
+/// of that code.
+#[inline(always)]
+unsafe fn pass(pc: *const u8, start: *const u8, table: &mut [u8]) -> *const u8 {
+    let length = LENGTHS[unsafe { *pc } as usize];
+    if length == 0 {
+        let offset = unsafe { pc.offset_from_unsigned(start) };
+        unsafe { *table.get_unchecked_mut(offset / 8) |= 1 << (offset % 8) };
+        return unsafe { pc.add(1) };
+    }
+    // A trailing PUSH can advance past the bytecode allocation.
+    pc.wrapping_add(length as usize)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{bytecode::analysis::tests::check_simd, interpreter::opcode::OpCode};
+
+    #[test]
+    fn test_lengths() {
+        for byte in 0..=u8::MAX {
+            let opcode = OpCode::new_or_unknown(byte);
+            let length = match byte {
+                op::JUMPDEST => 0,
+                _ if opcode.is_push() => 1 + opcode.immediate_size(),
+                _ => 1,
+            };
+            assert_eq!(LENGTHS[byte as usize], length, "{byte:#04x}");
+        }
+    }
+
+    #[test]
+    fn test_matches_reference() {
+        check_simd(analyze);
+    }
+
+    /// The loop stops where its next instructions could reach past the end, and at an
+    /// instruction.
+    #[test]
+    fn test_stops_before_the_end() {
+        for len in 0..700 {
+            for opcode in [op::ADD, op::JUMPDEST, op::PUSH1, op::PUSH31, op::PUSH32] {
+                let code = alloc::vec![opcode; len];
+                let mut table = alloc::vec![0; len.div_ceil(8)];
+                let pc = analyze(&code, &mut table);
+                let length =
+                    if opcode == op::JUMPDEST { 1 } else { LENGTHS[opcode as usize] as usize };
+                assert_eq!(pc % length, 0);
+                if len < REACH {
+                    assert_eq!(pc, 0);
+                } else {
+                    assert!(pc >= len - REACH && pc < len - REACH + UNROLLED * length);
+                }
+            }
+        }
+    }
+}
