+/// Reads the big-endian word in the 32 bytes at `p`.
+///
+/// # Safety
+///
+/// `p` must be valid for a read of 32 bytes.
+#[inline(always)]
+pub(crate) unsafe fn read_be_word(p: *const u8) -> Word {
+    core::cfg_select! {
+        any(target_arch = "riscv64", evm2_as_on_riscv64) => unsafe { read_be_word_by_alignment(p) },
+        _ => Word::from_be_bytes(unsafe { p.cast::<[u8; 32]>().read() }),
+    }
+}
+
+/// Writes `word` big-endian to the 32 bytes at `p`.
+///
+/// # Safety
+///
+/// `p` must be valid for a write of 32 bytes.
+#[inline(always)]
+pub(crate) unsafe fn write_be_word(p: *mut u8, word: &Word) {
+    core::cfg_select! {
+        any(target_arch = "riscv64", evm2_as_on_riscv64) => unsafe { write_be_word_by_alignment(p, word) },
+        _ => unsafe { p.cast::<[u8; 32]>().write(word.to_be_bytes::<32>()) },
+    }
+}
+
+/// Reads the big-endian word at `offset` of `data`, with zeros for the bytes past its end.
+#[inline]
+pub(crate) fn read_be_word_padded(data: &[u8], offset: usize) -> Word {
+    match data.get(offset..).and_then(|rest| rest.first_chunk::<32>()) {
+        // SAFETY: a chunk is 32 readable bytes.
+        Some(chunk) => unsafe { read_be_word(chunk.as_ptr()) },
+        None => word_from_be_bytes(&read_word_padded(data, offset).0),
+    }
+}
+
+/// The masks of the two stages of [`reverse_halves`].
+#[cfg(any(test, target_arch = "riscv64", evm2_as_on_riscv64))]
+static BYTES_MASK: u64 = 0x00ff_00ff_00ff_00ff;
+#[cfg(any(test, target_arch = "riscv64", evm2_as_on_riscv64))]
+static PAIRS_MASK: u64 = 0x0000_ffff_0000_ffff;
+
+/// The two masks, loaded from memory.
+///
+/// The volatile read hides their values from LLVM, which then loads them where it would build
+/// each constant in a register, and cannot fold the stages back into its own byte swap.
+#[cfg(any(test, target_arch = "riscv64", evm2_as_on_riscv64))]
+#[inline(always)]
+fn reversal_masks() -> (u64, u64) {
+    // SAFETY: both are initialised statics.
+    unsafe { (core::ptr::read_volatile(&BYTES_MASK), core::ptr::read_volatile(&PAIRS_MASK)) }
+}
+
+/// Reverses the bytes of each 32-bit half of `x`, given [`reversal_masks`]: adjacent bytes are
+/// swapped, then adjacent pairs of bytes. The halves stay where they are.
+///
+/// Ten instructions, in assembly because LLVM recognises the stages in Rust and replaces them
+/// with its own lowering of a byte swap, which on riscv64 without Zbb is an or-tree of the
+/// shifted bytes: 21 to 23 instructions for a `u64`, as measured in the revm fork this is taken
+/// from.
+#[cfg(all(target_arch = "riscv64", not(target_feature = "zbb")))]
+#[inline(always)]
+fn reverse_halves(x: u64, bytes: u64, pairs: u64) -> u64 {
+    let y: u64;
+    // SAFETY: arithmetic on registers; no memory, no stack.
+    unsafe {
+        core::arch::asm!(
+            "srli {t0}, {x}, 8",
+            "and  {t0}, {t0}, {bytes}",
+            "and  {t1}, {x}, {bytes}",
+            "slli {t1}, {t1}, 8",
+            "or   {y}, {t0}, {t1}",
+            "srli {t0}, {y}, 16",
+            "and  {t0}, {t0}, {pairs}",
+            "and  {t1}, {y}, {pairs}",
+            "slli {t1}, {t1}, 16",
+            "or   {y}, {t0}, {t1}",
+            x = in(reg) x,
+            bytes = in(reg) bytes,
+            pairs = in(reg) pairs,
+            t0 = out(reg) _,
+            t1 = out(reg) _,
+            y = out(reg) y,
+            options(pure, nomem, nostack, preserves_flags),
+        );
+    }
+    y
+}
+
+/// [`reverse_halves`] where the assembly does not apply: the same two stages, which is what the
+/// tests of a host run.
+#[cfg(all(
+    any(test, target_arch = "riscv64", evm2_as_on_riscv64),
+    not(all(target_arch = "riscv64", not(target_feature = "zbb")))
+))]
+#[inline(always)]
+const fn reverse_halves(x: u64, bytes: u64, pairs: u64) -> u64 {
+    let y = ((x >> 8) & bytes) | ((x & bytes) << 8);
+    ((y >> 16) & pairs) | ((y & pairs) << 16)
+}
+
+/// Reverses the bytes of `x`: [`reverse_halves`], and the halves exchanged.
+#[cfg(any(test, target_arch = "riscv64", evm2_as_on_riscv64))]
+#[inline(always)]
+fn reverse_bytes(x: u64, bytes: u64, pairs: u64) -> u64 {
+    reverse_halves(x, bytes, pairs).rotate_left(32)
+}
+
+/// Reads the big-endian word in the four `u64`s at `p`. A limb that is zero is not reversed.
+///
+/// # Safety
+///
+/// `p` must be valid for a read of four `u64`s.
+#[cfg(any(test, target_arch = "riscv64", evm2_as_on_riscv64))]
+#[inline(always)]
+pub(crate) unsafe fn read_be_word_aligned(p: *const u64) -> Word {
+    let (bytes, pairs) = reversal_masks();
+    // SAFETY: four readable `u64`s.
+    let limb = |i: usize| match unsafe { p.add(i).read() } {
+        0 => 0,
+        x => reverse_bytes(x, bytes, pairs),
+    };
+    Word::from_limbs([limb(3), limb(2), limb(1), limb(0)])
+}
+
+/// Writes `word` big-endian to the four `u64`s at `p`. A limb that is zero is not reversed.
+///
+/// # Safety
+///
+/// `p` must be valid for a write of four `u64`s.
+#[cfg(any(test, target_arch = "riscv64", evm2_as_on_riscv64))]
+#[inline(always)]
+pub(crate) unsafe fn write_be_word_aligned(p: *mut u64, word: &Word) {
+    let (bytes, pairs) = reversal_masks();
+    let [l0, l1, l2, l3] = *word.as_limbs();
+    let put = |i: usize, limb: u64| {
+        let x = if limb == 0 { 0 } else { reverse_bytes(limb, bytes, pairs) };
+        // SAFETY: four writable `u64`s.
+        unsafe { p.add(i).write(x) }
+    };
+    put(0, l3);
+    put(1, l2);
+    put(2, l1);
+    put(3, l0);
+}
+
+/// Reads the big-endian word in the eight `u32`s at `p`. With the half from the lower address
+/// put in the upper half of the limb, only the bytes of each half are left to reverse.
+///
+/// # Safety
+///
+/// `p` must be valid for a read of eight `u32`s.
+#[cfg(any(test, target_arch = "riscv64", evm2_as_on_riscv64))]
+#[inline(always)]
+pub(crate) unsafe fn read_be_word_halves(p: *const u32) -> Word {
+    let (bytes, pairs) = reversal_masks();
+    let limb = |i: usize| {
+        // SAFETY: eight readable `u32`s.
+        let (upper, lower) = unsafe { (p.add(2 * i).read(), p.add(2 * i + 1).read()) };
+        match u64::from(upper) << 32 | u64::from(lower) {
+            0 => 0,
+            x => reverse_halves(x, bytes, pairs),
+        }
+    };
+    Word::from_limbs([limb(3), limb(2), limb(1), limb(0)])
+}
+
+/// [`read_be_word`] for a target with neither misaligned loads nor a byte swap, riscv64im.
+///
+/// Byte by byte a word is 32 loads, each with its shift. At a multiple of 8 it is four loads and
+/// the reversal of each limb. At a multiple of 4 it is eight loads, and with the half from the
+/// lower address put in the upper half of the limb, only the bytes of each half are left to
+/// reverse. A limb that is zero is not reversed.
+///
+/// # Safety
+///
+/// `p` must be valid for a read of 32 bytes.
+#[cfg(any(test, target_arch = "riscv64", evm2_as_on_riscv64))]
+#[inline(always)]
+unsafe fn read_be_word_by_alignment(p: *const u8) -> Word {
+    let address = p as usize;
+    if address.is_multiple_of(8) {
+        // SAFETY: 32 readable bytes at a multiple of 8.
+        unsafe { read_be_word_aligned(p.cast()) }
+    } else if address.is_multiple_of(4) {
+        // SAFETY: 32 readable bytes at a multiple of 4.
+        unsafe { read_be_word_halves(p.cast()) }
+    } else {
+        // SAFETY: 32 readable bytes.
+        word_from_be_bytes_bytewise(unsafe { &*p.cast::<[u8; 32]>() })
+    }
+}
+
+/// [`write_be_word`] for riscv64im: the mirror of [`read_be_word_by_alignment`].
+///
+/// # Safety
+///
+/// `p` must be valid for a write of 32 bytes.
+#[cfg(any(test, target_arch = "riscv64", evm2_as_on_riscv64))]
+#[inline(always)]
+unsafe fn write_be_word_by_alignment(p: *mut u8, word: &Word) {
+    let address = p as usize;
+    if address.is_multiple_of(8) {
+        // SAFETY: 32 writable bytes at a multiple of 8.
+        unsafe { write_be_word_aligned(p.cast(), word) }
+    } else if address.is_multiple_of(4) {
+        let (bytes, pairs) = reversal_masks();
+        let [l0, l1, l2, l3] = *word.as_limbs();
+        let p = p.cast::<u32>();
+        let put = |i: usize, limb: u64| {
+            let x = if limb == 0 { 0 } else { reverse_halves(limb, bytes, pairs) };
+            // SAFETY: 32 writable bytes at a multiple of 4. The upper half goes to the lower
+            // address.
+            unsafe {
+                p.add(2 * i).write((x >> 32) as u32);
+                p.add(2 * i + 1).write(x as u32);
+            }
+        };
+        put(0, l3);
+        put(1, l2);
+        put(2, l1);
+        put(3, l0);
+    } else {
+        // SAFETY: 32 writable bytes.
+        unsafe { p.cast::<[u8; 32]>().write(word.to_be_bytes::<32>()) }
+    }
+}
