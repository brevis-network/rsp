+    /// 64 bytes that start at a multiple of 8.
+    #[repr(align(8))]
+    struct Aligned([u8; 64]);
+
+    /// Words of every shape the paths by alignment tell apart: each limb zero or not, small
+    /// values, an address, all ones, and bytes that are all different.
+    fn words() -> Vec<[u8; 32]> {
+        let mut words = vec![[0; 32], [0xff; 32], core::array::from_fn(|i| i as u8 + 1)];
+        for zero_limbs in 0u8..16 {
+            words.push(core::array::from_fn(|i| {
+                if zero_limbs >> (i / 8) & 1 == 1 { 0 } else { (i as u8).wrapping_mul(37) ^ 0x80 }
+            }));
+        }
+        for len in 1..=32 {
+            words.push(core::array::from_fn(|i| if i >= 32 - len { 0xa0 + i as u8 } else { 0 }));
+        }
+        // An address: twelve zero bytes and twenty that are not.
+        words.push(core::array::from_fn(|i| if i < 12 { 0 } else { 0xc0 + i as u8 }));
+        let mut state = 0x9e37_79b9_7f4a_7c15u64;
+        for _ in 0..200 {
+            words.push(core::array::from_fn(|_| {
+                state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+                (state >> 56) as u8
+            }));
+        }
+        words
+    }
+
+    #[test]
+    fn a_word_is_read_the_same_at_every_alignment() {
+        for bytes in words() {
+            let expected = Word::from_be_bytes(bytes);
+            for shift in 0..16 {
+                let mut buffer = Aligned([0xa5; 64]);
+                buffer.0[shift..shift + 32].copy_from_slice(&bytes);
+                let p = buffer.0[shift..].as_ptr();
+                assert_eq!(p as usize % 8, shift % 8);
+                assert_eq!(unsafe { read_be_word_by_alignment(p) }, expected, "shift {shift}");
+                assert_eq!(unsafe { read_be_word(p) }, expected, "shift {shift}");
+            }
+        }
+    }
+
+    #[test]
+    fn a_word_is_written_the_same_at_every_alignment_and_nothing_beside_it() {
+        for bytes in words() {
+            let word = Word::from_be_bytes(bytes);
+            for shift in 0..16 {
+                for write in [0, 1] {
+                    let mut buffer = Aligned([0x5a; 64]);
+                    let p = buffer.0[shift..].as_mut_ptr();
+                    if write == 0 {
+                        unsafe { write_be_word_by_alignment(p, &word) };
+                    } else {
+                        unsafe { write_be_word(p, &word) };
+                    }
+                    assert_eq!(buffer.0[shift..shift + 32], bytes, "shift {shift}");
+                    let beside = buffer.0[..shift].iter().chain(&buffer.0[shift + 32..]);
+                    assert!(beside.copied().all(|byte| byte == 0x5a), "shift {shift}");
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn the_two_stages_reverse_the_bytes_of_each_half() {
+        let (bytes, pairs) = reversal_masks();
+        assert_eq!((bytes, pairs), (0x00ff_00ff_00ff_00ff, 0x0000_ffff_0000_ffff));
+        let mut x = 0x0123_4567_89ab_cdefu64;
+        for _ in 0..1000 {
+            let halves = u64::from(((x >> 32) as u32).swap_bytes()) << 32
+                | u64::from((x as u32).swap_bytes());
+            assert_eq!(reverse_halves(x, bytes, pairs), halves);
+            assert_eq!(reverse_bytes(x, bytes, pairs), x.swap_bytes());
+            x = x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+        }
+        for x in [0, 1, u64::MAX, 0xff, 0xff00_0000_0000_0000] {
+            assert_eq!(reverse_bytes(x, bytes, pairs), x.swap_bytes());
+        }
+    }
+
+    #[test]
+    fn a_word_past_the_end_of_the_data_is_padded_with_zeros() {
+        let data: Vec<u8> = (1..=70).collect();
+        for len in [0, 1, 31, 32, 33, 63, 64, 70] {
+            let data = &data[..len];
+            for offset in (0..80).chain([usize::MAX - 31, usize::MAX]) {
+                let expected = Word::from_be_bytes(read_word_padded(data, offset).0);
+                assert_eq!(read_be_word_padded(data, offset), expected, "{len} {offset}");
+            }
+        }
+    }
