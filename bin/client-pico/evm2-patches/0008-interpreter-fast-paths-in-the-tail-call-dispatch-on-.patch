+/// What the fast paths of the tail-call dispatch on riscv64 ask of the stack.
+#[cfg(all(tco, any(target_arch = "riscv64", evm2_as_on_riscv64)))]
+impl RawStack<'_> {
+    /// Whether a push would overflow.
+    #[inline(always)]
+    pub(crate) const fn is_full(self) -> bool {
+        self.len == Stack::CAPACITY * RAW_LEN_SCALE
+    }
+
+    /// Whether there is no word to pop.
+    #[inline(always)]
+    pub(crate) const fn is_empty(self) -> bool {
+        self.len == 0
+    }
+
+    /// Whether there are `words` words to pop.
+    #[inline(always)]
+    pub(crate) const fn has(self, words: usize) -> bool {
+        self.len >= words * RAW_LEN_SCALE
+    }
+
+    /// The slot above the top.
+    #[inline(always)]
+    const fn end(self) -> *mut Word {
+        // The stored length in bytes: itself where it is kept in bytes, so there is no shift.
+        let bytes = self.len * (size_of::<Word>() / RAW_LEN_SCALE);
+        // SAFETY: At most the capacity of the backing.
+        unsafe { self.stack.cast::<Word>().byte_add(bytes) }
+    }
+
+    /// The word `depth` below the one on top.
+    ///
+    /// # Safety
+    ///
+    /// The stack has more than `depth` words. The word may be read and written while no
+    /// [`Stack`] borrowed from this stack is live.
+    #[inline(always)]
+    pub(crate) const unsafe fn below_top_unchecked(self, depth: usize) -> *mut Word {
+        // SAFETY: The first `len` words are in the backing, and the caller has `len > depth`.
+        unsafe { self.end().sub(depth + 1) }
+    }
+
+    /// Pops `words` words without reading them.
+    ///
+    /// # Safety
+    ///
+    /// The stack has that many.
+    #[inline(always)]
+    pub(crate) const unsafe fn drop_unchecked(&mut self, words: usize) {
+        self.len -= words * RAW_LEN_SCALE;
+    }
+
+    /// Pushes `value`.
+    ///
+    /// # Safety
+    ///
+    /// The stack is not full, and no [`Stack`] borrowed from it is live.
+    #[inline(always)]
+    pub(crate) const unsafe fn push_u64_unchecked(&mut self, value: u64) {
+        // SAFETY: The slot above the top is in the backing while the stack is not full.
+        unsafe { self.end().write(Word::from_limbs([value, 0, 0, 0])) };
