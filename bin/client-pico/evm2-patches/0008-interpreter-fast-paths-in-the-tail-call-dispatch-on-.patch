+#[cfg(test)]
+mod tests {
+    //! Programs over the opcodes around a jump and over words in memory, against models that run
+    //! them one opcode at a time. The models are the same for every build, so they hold the fast
+    //! paths of the tail-call dispatch (riscv64, or a host built with `--cfg evm2_as_on_riscv64`)
+    //! to what the instructions do.
+
+    use crate::{
+        interpreter::{InstrStop, Word, op},
+        test_utils::{RunConfig, run},
+    };
+    use alloc::{format, vec, vec::Vec};
+
+    const STACK_LIMIT: usize = 1024;
+
+    /// How a run stopped and with how many words on the stack and, when it stopped at a `STOP`,
+    /// the gas left and the words.
+    #[derive(Debug, PartialEq, Eq)]
+    struct Outcome {
+        stop: InstrStop,
+        stack_len: usize,
+        at_stop: Option<(u64, Vec<u64>)>,
+    }
+
+    /// What became of a `PUSH2` that a `JUMP` or `JUMPI` follows, by the case the fused step
+    /// tells apart.
+    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+    enum Pair {
+        FullStack,
+        NoCondition,
+        NoGasForTheJump,
+        NotTaken,
+        BadTarget,
+        TakenWithGasForTheJumpdest,
+        TakenWithoutGasForTheJumpdest,
+    }
+
+    const PAIRS: [Pair; 7] = [
+        Pair::FullStack,
+        Pair::NoCondition,
+        Pair::NoGasForTheJump,
+        Pair::NotTaken,
+        Pair::BadTarget,
+        Pair::TakenWithGasForTheJumpdest,
+        Pair::TakenWithoutGasForTheJumpdest,
+    ];
+
+    /// Runs `code` one opcode at a time: the static gas first, then the stack, then the effect.
+    /// `pairs` counts the `PUSH2` + jump pairs it executes, by case.
+    fn model(code: &[u8], gas_limit: u64, pairs: &mut [usize; 7]) -> Outcome {
+        let at = |pc: usize| code.get(pc).copied().unwrap_or(op::STOP);
+        let mut dests = vec![false; code.len()];
+        let mut i = 0;
+        while i < code.len() {
+            match code[i] {
+                op::JUMPDEST => dests[i] = true,
+                push @ op::PUSH1..=op::PUSH32 => i += (push - op::PUSH1 + 1) as usize,
+                _ => {}
+            }
+            i += 1;
+        }
+        let is_dest = |target: u64| dests.get(target as usize).copied().unwrap_or(false);
+        let fail = |stop, stack_len| Outcome { stop, stack_len, at_stop: None };
+
+        let (mut pc, mut gas, mut stack) = (0usize, gas_limit, Vec::<u64>::new());
+        loop {
+            let opcode = at(pc);
+            let (cost, pops, pushes) = match opcode {
+                op::STOP => {
+                    let stack_len = stack.len();
+                    return Outcome {
+                        stop: InstrStop::Stop,
+                        stack_len,
+                        at_stop: Some((gas, stack)),
+                    };
+                }
+                op::POP => (2, 1, 0),
+                op::JUMP => (8, 1, 0),
+                op::JUMPI => (10, 2, 0),
+                op::JUMPDEST => (1, 0, 0),
+                op::PUSH0 => (2, 0, 1),
+                op::PUSH1 | op::PUSH2 => (3, 0, 1),
+                op::DUP1 => (3, 1, 2),
+                _ => unreachable!("the programs have no {opcode:#x}"),
+            };
+            let immediate = |n: usize| (1..=n).fold(0u64, |v, k| v << 8 | at(pc + k) as u64);
+
+            // The case of a pair, from the state before its `PUSH2`.
+            if opcode == op::PUSH2 && gas >= cost && matches!(at(pc + 3), op::JUMP | op::JUMPI) {
+                let jumpi = at(pc + 3) == op::JUMPI;
+                let jump_cost = if jumpi { 10 } else { 8 };
+                let left = gas - cost;
+                let case = if stack.len() == STACK_LIMIT {
+                    Pair::FullStack
+                } else if jumpi && stack.is_empty() {
+                    Pair::NoCondition
+                } else if left < jump_cost {
+                    Pair::NoGasForTheJump
+                } else if jumpi && *stack.last().unwrap() == 0 {
+                    Pair::NotTaken
+                } else if !is_dest(immediate(2)) {
+                    Pair::BadTarget
+                } else if left - jump_cost >= 1 {
+                    Pair::TakenWithGasForTheJumpdest
+                } else {
+                    Pair::TakenWithoutGasForTheJumpdest
+                };
+                pairs[PAIRS.iter().position(|p| *p == case).unwrap()] += 1;
+            }
+
+            // A failed opcode leaves the stack as it found it; a jump has popped its operands
+            // when it finds its target is none.
+            if gas < cost {
+                return fail(InstrStop::OutOfGas, stack.len());
+            }
+            gas -= cost;
+            if stack.len() < pops {
+                return fail(InstrStop::StackUnderflow, stack.len());
+            }
+            if stack.len() - pops + pushes > STACK_LIMIT {
+                return fail(InstrStop::StackOverflow, stack.len());
+            }
+            match opcode {
+                op::POP => {
+                    stack.pop();
+                    pc += 1;
+                }
+                op::JUMPDEST => pc += 1,
+                op::PUSH0 => {
+                    stack.push(0);
+                    pc += 1;
+                }
+                op::PUSH1 => {
+                    stack.push(immediate(1));
+                    pc += 2;
+                }
+                op::PUSH2 => {
+                    stack.push(immediate(2));
+                    pc += 3;
+                }
+                op::DUP1 => {
+                    stack.push(*stack.last().unwrap());
+                    pc += 1;
+                }
+                _ => {
+                    let target = stack.pop().unwrap();
+                    if opcode == op::JUMPI && stack.pop().unwrap() == 0 {
+                        pc += 1;
+                    } else if is_dest(target) {
+                        pc = target as usize;
+                    } else {
+                        return fail(InstrStop::InvalidJump, stack.len());
+                    }
+                }
+            }
+        }
+    }
+
+    /// Runs `code` on the interpreter and on the model, and compares. Returns everything the
+    /// interpreter leaves behind, as text: a build that fuses and one that does not must leave
+    /// the same, also where the model does not look (the gas and the stack of a failed run).
+    fn check(code: &[u8], gas_limit: u64, pairs: &mut [usize; 7]) -> alloc::string::String {
+        let expected = model(code, gas_limit, pairs);
+        let interp = run(RunConfig::new(code).gas_limit(gas_limit));
+        let stack: Vec<Word> = interp.stack().to_vec();
+        let at_stop = (interp.err == InstrStop::Stop).then(|| {
+            (interp.gas_remaining(), stack.iter().map(|w| w.to::<u64>()).collect::<Vec<_>>())
+        });
+        assert_eq!(
+            Outcome { stop: interp.err, stack_len: interp.stack_len, at_stop },
+            expected,
+            "gas limit {gas_limit}, code {}",
+            alloy_primitives::hex::encode(code)
+        );
+        format!("{:?} {} {} {:?}", interp.err, interp.gas_remaining(), interp.stack_len, stack)
+    }
+
+    /// `depth` words on the stack first, and the gas that takes.
+    fn with_depth(depth: usize, body: &[u8]) -> (Vec<u8>, u64) {
+        let mut code = vec![op::PUSH0; depth];
+        code.extend_from_slice(body);
+        (code, 2 * depth as u64)
+    }
+
+    /// The offset of a body's byte in the code [`with_depth`] gives, as a `PUSH2` operand.
+    fn target(depth: usize, offset: usize) -> [u8; 2] {
+        ((depth + offset) as u16).to_be_bytes()
+    }
+
+    /// Every case of a pair, at every depth where the stack decides and every gas limit up to
+    /// past the last opcode.
+    #[test]
+    fn push2_and_the_jump_after_it_at_every_gas_limit_and_depth() {
+        let mut pairs = [0usize; 7];
+        for depth in [0, 1, 2, STACK_LIMIT - 2, STACK_LIMIT - 1, STACK_LIMIT] {
+            let t = |offset: usize| target(depth, offset);
+            let bodies: Vec<Vec<u8>> = vec![
+                // jump to a JUMPDEST, right after and further on
+                vec![op::PUSH2, t(4)[0], t(4)[1], op::JUMP, op::JUMPDEST, op::STOP],
+                vec![op::PUSH2, t(6)[0], t(6)[1], op::JUMP, op::STOP, op::STOP, op::JUMPDEST],
+                // a JUMPDEST followed by more
+                vec![op::PUSH2, t(4)[0], t(4)[1], op::JUMP, op::JUMPDEST, op::PUSH0, op::POP],
+                // to something that is no JUMPDEST, to the data of a push, past the end
+                vec![op::PUSH2, t(5)[0], t(5)[1], op::JUMP, op::JUMPDEST, op::STOP],
+                vec![op::PUSH2, t(5)[0], t(5)[1], op::JUMP, op::PUSH1, op::JUMPDEST, op::STOP],
+                vec![op::PUSH2, 0xff, 0xff, op::JUMP, op::JUMPDEST],
+                // JUMPI on whatever is on top (nothing, or a zero), and on a one
+                vec![op::PUSH2, t(4)[0], t(4)[1], op::JUMPI, op::JUMPDEST, op::STOP],
+                vec![op::PUSH2, t(5)[0], t(5)[1], op::JUMPI, op::STOP, op::JUMPDEST, op::PUSH0],
+                vec![op::POP, op::PUSH1, 1, op::PUSH2, t(7)[0], t(7)[1], op::JUMPI, op::JUMPDEST],
+                vec![op::POP, op::PUSH1, 1, op::PUSH2, t(8)[0], t(8)[1], op::JUMPI, op::JUMPDEST],
+                vec![op::POP, op::PUSH1, 0, op::PUSH2, t(8)[0], t(8)[1], op::JUMPI, op::PUSH0],
+                // a loop, until the gas is gone
+                vec![op::JUMPDEST, op::PUSH2, t(0)[0], t(0)[1], op::JUMP],
+                vec![op::JUMPDEST, op::PUSH1, 1, op::PUSH2, t(0)[0], t(0)[1], op::JUMPI],
+                // PUSH2 with the jump or its own operand in the padding
+                vec![op::PUSH2, 0, 0],
+                vec![op::PUSH2, 0],
+                vec![op::PUSH2],
+                vec![op::JUMPDEST, op::PUSH2, 0, 0, op::JUMP],
+            ];
+            for body in bodies {
+                let (code, floor) = with_depth(depth, &body);
+                for gas in 0..=40 {
+                    check(&code, floor + gas, &mut pairs);
+                }
+                // and with too little for the words under it
+                check(&code, floor.saturating_sub(1), &mut pairs);
+            }
+        }
+        for (case, count) in PAIRS.iter().zip(pairs) {
+            assert!(count > 0, "no program reached {case:?}");
+        }
+    }
+
+    /// Two `JUMPDEST`s at offsets that are each other with the bytes swapped, and a different
+    /// word pushed after each: a jump lands where its operand says high byte first.
+    #[test]
+    fn a_jump_reads_its_target_high_byte_first() {
+        let mut pairs = [0usize; 7];
+        for jumpi in [false, true] {
+            for (operand, lands_on) in [([0x01, 0x02], 1), ([0x02, 0x01], 2)] {
+                let mut code = vec![op::STOP; 0x0201 + 4];
+                let head: &[u8] = if jumpi {
+                    &[op::PUSH1, 1, op::PUSH2, operand[0], operand[1], op::JUMPI]
+                } else {
+                    &[op::PUSH2, operand[0], operand[1], op::JUMP]
+                };
+                code[..head.len()].copy_from_slice(head);
+                code[0x0102..0x0102 + 3].copy_from_slice(&[op::JUMPDEST, op::PUSH1, 1]);
+                code[0x0201..0x0201 + 3].copy_from_slice(&[op::JUMPDEST, op::PUSH1, 2]);
+                for gas in 0..=30 {
+                    check(&code, gas, &mut pairs);
+                }
+                let interp = run(RunConfig::new(code).gas_limit(30));
+                assert_eq!(interp.err, InstrStop::Stop);
+                assert_eq!(interp.stack(), [Word::from(lands_on)]);
+            }
+        }
+    }
+
+    /// xorshift64: deterministic, so a failure reproduces.
+    struct Rng(u64);
+
+    impl Rng {
+        fn next(&mut self) -> u64 {
+            self.0 ^= self.0 << 13;
+            self.0 ^= self.0 >> 7;
+            self.0 ^= self.0 << 17;
+            self.0
+        }
+
+        fn below(&mut self, n: u64) -> u64 {
+            self.next() % n
+        }
+    }
+
+    /// Random programs over the same opcodes. Prints a digest of everything the interpreter left
+    /// behind over all of them (`--nocapture`), which a build that fuses and a build that does
+    /// not must agree on.
+    #[test]
+    fn random_programs_around_jumps_run_as_one_opcode_at_a_time() {
+        let mut rng = Rng(0x6a09_e667_f3bc_c908);
+        let mut pairs = [0usize; 7];
+        let mut digest = 0xcbf2_9ce4_8422_2325u64;
+        let programs = 200_000;
+        for _ in 0..programs {
+            let depth = match rng.below(16) {
+                0 => STACK_LIMIT,
+                1 => STACK_LIMIT - 1,
+                2 => STACK_LIMIT - 2,
+                _ => rng.below(3) as usize,
+            };
+            let len = 1 + rng.below(40) as usize;
+            let mut body = Vec::with_capacity(len + 4);
+            while body.len() < len {
+                // an operand that is mostly an offset of this body, at times anything
+                let near = |rng: &mut Rng| match rng.below(12) {
+                    0 => rng.next() as u16,
+                    _ => (depth as u64 + rng.below(len as u64 + 2)) as u16,
+                };
+                match rng.below(20) {
+                    0..=4 => {
+                        let [hi, lo] = near(&mut rng).to_be_bytes();
+                        let jump = if rng.below(2) == 0 { op::JUMP } else { op::JUMPI };
+                        body.extend([op::PUSH2, hi, lo, jump]);
+                    }
+                    5..=8 => body.push(op::JUMPDEST),
+                    9..=10 => body.extend([op::PUSH1, rng.below(3) as u8]),
+                    11 => body.extend([op::PUSH1, near(&mut rng) as u8]),
+                    12 => {
+                        let [hi, lo] = near(&mut rng).to_be_bytes();
+                        body.extend([op::PUSH2, hi, lo]);
+                    }
+                    13 => body.push(op::PUSH0),
+                    14 => body.push(op::DUP1),
+                    15..=16 => body.push(op::POP),
+                    17 => body.push(op::JUMP),
+                    18 => body.push(op::JUMPI),
+                    _ => body.push(op::STOP),
+                }
+            }
+            // at times cut inside the last instruction
+            body.truncate(len + rng.below(4) as usize);
+            let (code, floor) = with_depth(depth, &body);
+            let gas = match rng.below(8) {
+                0 => floor.saturating_sub(rng.below(4)),
+                1..=4 => floor + rng.below(60),
+                _ => floor + rng.below(400),
+            };
+            for byte in check(&code, gas, &mut pairs).bytes() {
+                digest = (digest ^ byte as u64).wrapping_mul(0x0000_0100_0000_01b3);
+            }
+        }
+        for (case, count) in PAIRS.iter().zip(pairs) {
+            assert!(count > 100, "only {count} programs reached {case:?}");
+        }
+        std::println!("jump programs: {programs}, pairs by case {pairs:?}, digest {digest:016x}");
+    }
+
+    /// Words stored and loaded at offsets of every alignment, inside the memory and past its
+    /// end, against a memory kept as bytes; then the same with the gas running out at a random
+    /// opcode, for which of the two kinds of gas it is.
+    #[test]
+    fn words_in_memory_are_stored_and_loaded_as_their_bytes() {
+        let mut rng = Rng(0x243f_6a88_85a3_08d3);
+        let cost = |words: u64| 3 * words + words * words / 512;
+        let (mut stops, mut failures, mut inside, mut aligned) = (0, 0, 0, 0);
+        for round in 0..20_000 {
+            let mut code = Vec::new();
+            // What each opcode needs of the gas: its static gas, then the gas for the memory.
+            let mut needs: Vec<(u64, u64)> = Vec::new();
+            let (mut memory, mut stack) = (Vec::<u8>::new(), Vec::<Word>::new());
+            for _ in 0..1 + rng.below(10) {
+                let offset = match rng.below(8) {
+                    0 => rng.below(300),
+                    1 => 32 * rng.below(8) + 4,
+                    2 => 32 * rng.below(8) + 8 * rng.below(4),
+                    _ => 32 * rng.below(8),
+                } as usize;
+                let kind = rng.below(8);
+                let size = if kind == 7 { 1 } else { 32 };
+                if kind < 7 && offset + size <= memory.len() {
+                    inside += 1;
+                    aligned += usize::from(offset % 8 == 0);
+                }
+                let (old, new) = (memory.len() as u64 / 32, (offset + size).div_ceil(32) as u64);
+                let grown = if new > old { cost(new) - cost(old) } else { 0 };
+                memory.resize(old.max(new) as usize * 32, 0);
+                let [high, low] = (offset as u16).to_be_bytes();
+                match kind {
+                    0..=3 => {
+                        // nothing but zeros, eight bytes, an address, a full word
+                        let mut bytes = [0u8; 32];
+                        let from = [32, 24, 12, 0][rng.below(4) as usize];
+                        bytes[from..].fill_with(|| rng.next() as u8);
+                        code.push(op::PUSH32);
+                        code.extend(bytes);
+                        code.extend([op::PUSH2, high, low, op::MSTORE]);
+                        needs.extend([(3, 0), (3, 0), (3, grown)]);
+                        memory[offset..offset + 32].copy_from_slice(&bytes);
+                    }
+                    4..=6 => {
+                        code.extend([op::PUSH2, high, low, op::MLOAD]);
+                        needs.extend([(3, 0), (3, grown)]);
+                        stack.push(Word::from_be_slice(&memory[offset..offset + 32]));
+                    }
+                    _ => {
+                        let byte = rng.next() as u8;
+                        code.extend([op::PUSH1, byte, op::PUSH2, high, low, op::MSTORE8]);
+                        needs.extend([(3, 0), (3, 0), (3, grown)]);
+                        memory[offset] = byte;
+                    }
+                }
+            }
+            code.push(op::MSIZE);
+            needs.push((2, 0));
+            stack.push(Word::from(memory.len() as u64));
+
+            let total: u64 = needs.iter().map(|(fixed, grown)| fixed + grown).sum();
+            let limit = if round % 4 == 0 { rng.below(total) } else { total + rng.below(50) };
+            let interp = run(RunConfig::new(&code[..]).gas_limit(limit));
+            let code = alloy_primitives::hex::encode(&code);
+            if limit >= total {
+                assert_eq!(interp.err, InstrStop::Stop, "gas limit {limit}, code {code}");
+                assert_eq!(interp.gas_remaining(), limit - total, "gas limit {limit}, code {code}");
+                assert_eq!(interp.stack().to_vec(), stack, "gas limit {limit}, code {code}");
+                stops += 1;
+            } else {
+                let mut left = limit;
+                let expected = needs.iter().find_map(|(fixed, grown)| {
+                    if left < *fixed {
+                        return Some(InstrStop::OutOfGas);
+                    }
+                    left -= fixed;
+                    if left < *grown {
+                        return Some(InstrStop::MemoryOOG);
+                    }
+                    left -= grown;
+                    None
+                });
+                assert_eq!(Some(interp.err), expected, "gas limit {limit}, code {code}");
+                failures += 1;
+            }
+        }
+        // Both ends of every run, and words inside the memory at multiples of 8 and elsewhere.
+        assert!(stops > 10_000 && failures > 3_000, "{stops} {failures}");
+        assert!(aligned > 10_000 && inside - aligned > 3_000, "{inside} {aligned}");
+    }
+}
