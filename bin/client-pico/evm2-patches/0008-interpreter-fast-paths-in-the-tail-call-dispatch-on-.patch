     opcode_config.revision(op) != previous_opcode_config.revision(op)
 }
 
+/// Whether the handler of `op` also runs other opcodes, one of which changed. On riscv64 the
+/// tail-call dispatch has fast paths in which a jump runs the `JUMPDEST` it lands on and `PUSH2`
+/// the jump after it; those handlers carry the static gas and the meaning of the opcodes they
+/// run, so they are rebuilt when one of them changes.
+const fn fused_with_changed<T: EvmTypesHost>(
+    opcode_config: &OpcodeConfig<T>,
+    previous_opcode_config: Option<&OpcodeConfig<T>>,
+    op: u8,
+) -> bool {
+    if !cfg!(any(target_arch = "riscv64", evm2_as_on_riscv64)) {
+        return false;
+    }
+    let landing = instruction_changed(opcode_config, previous_opcode_config, op::JUMPDEST);
+    match op {
+        op::JUMP | op::JUMPI => landing,
+        op::PUSH2 => {
+            landing
+                || instruction_changed(opcode_config, previous_opcode_config, op::JUMP)
+                || instruction_changed(opcode_config, previous_opcode_config, op::JUMPI)
+        }
+        _ => false,
+    }
+}
+
 trait InspectMode<T: EvmTypesHost> {
     /// Whether the dispatch calls the inspector's step hooks: from the handlers on the tail-call
     /// backend, and from the loop on the others, where a hook must not run while a handler holds
@@ -262,3 +289,434 @@ impl<T: EvmTypesHost, const ALL: bool> InspectMode<T> for DynInspector<ALL> {
         state.inspect_step_end(pc, stack_len);
     }
 }
