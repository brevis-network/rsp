diff --git a/crates/evm2/src/interpreter/dispatch/tco/fast.rs b/crates/evm2/src/interpreter/dispatch/tco/fast.rs
new file mode 100644
index 00000000..431b3a59
--- /dev/null
+++ b/crates/evm2/src/interpreter/dispatch/tco/fast.rs
@@ -0,0 +1,409 @@
+//! Fast paths of the tail-call dispatch on riscv64.
+//!
+//! On riscv64 a handler that calls anything, on a cold path as well, saves the registers it keeps
+//! across the call when it is entered and restores them when it leaves: 22 instructions in
+//! `MSTORE`, around its own work. An instruction too large to be inlined into its handler is
+//! called from it, and that costs the same again.
+//!
+//! A fast path is the common case of an opcode, written without a call. [`dispatch`] tries it
+//! first. Where its conditions do not hold it has changed nothing, and the handler leaves with a
+//! tail call to [`dispatch_generic`], which runs the instruction as any other is run, with its
+//! checks and its failures.
+//!
+//! [`dispatch`]: super::dispatch
+//! [`dispatch_generic`]: super::dispatch_generic
+
+use crate::{
+    EvmConfig, EvmTypesHost,
+    interpreter::{InterpreterState, Pc, RawStack, Word, gas::RemainingGas, op},
+};
+
+/// Whether `C` has each of `opcodes` as its base spec has it. The static gas is always read from
+/// `C`.
+const fn as_in_base<T: EvmTypesHost, C: EvmConfig<T>>(opcodes: &[u8]) -> bool {
+    let config = C::OPCODE_CONFIG;
+    let base = crate::evm::config::SelectorOpcodeConfig::<
+        T,
+        crate::BaseEvmConfigSelector,
+        { u32::MAX },
+    >::OPCODE_CONFIG[C::BASE_SPEC_ID as usize];
+    let mut i = 0;
+    while i < opcodes.len() {
+        if config.is_unknown_opcode(opcodes[i]) || config.is_overridden(base, opcodes[i]) {
+            return false;
+        }
+        i += 1;
+    }
+    true
+}
+
+/// Whether the handler of `opcode` starts with a fast path: for the six opcodes below, in a
+/// config that has them, and what their fast paths run of other opcodes, as its base spec has.
+pub(super) const fn has<T: EvmTypesHost, C: EvmConfig<T>>(opcode: u8) -> bool {
+    match opcode {
+        op::MLOAD | op::MSTORE | op::CALLDATALOAD | op::PUSH2 => as_in_base::<T, C>(&[opcode]),
+        // A jump that is taken runs the `JUMPDEST` it lands on.
+        op::JUMP | op::JUMPI => as_in_base::<T, C>(&[opcode, op::JUMPDEST]),
+        _ => false,
+    }
+}
+
+/// Whether `PUSH2` runs a `JUMP` or `JUMPI` that follows it.
+const fn fuses_jumps<T: EvmTypesHost, C: EvmConfig<T>>() -> bool {
+    as_in_base::<T, C>(&[op::PUSH2, op::JUMP, op::JUMPI, op::JUMPDEST])
+}
+
+/// Runs the instruction at `pc` on its fast path, and returns the opcode the pc is then at, for
+/// the handler to pass control to. `None` when the fast path does not apply; nothing has changed
+/// then.
+///
+/// `OP` must be an opcode for which [`has`] holds.
+#[inline(always)]
+pub(super) fn run<T: EvmTypesHost, C: EvmConfig<T>, const OP: u8>(
+    pc: &mut Pc,
+    stack: &mut RawStack<'_>,
+    gas: &mut RemainingGas,
+    state: &mut InterpreterState<'_, '_, T>,
+) -> Option<u8> {
+    match OP {
+        op::MLOAD => mload::<T, C>(pc, stack, gas, state),
+        op::MSTORE => mstore::<T, C>(pc, stack, gas, state),
+        op::CALLDATALOAD => calldataload::<T, C>(pc, stack, gas, state),
+        op::JUMP => jump::<T, C>(pc, stack, gas, state),
+        op::JUMPI => jumpi::<T, C>(pc, stack, gas, state),
+        op::PUSH2 => push2::<T, C>(pc, stack, gas, state),
+        _ => None,
+    }
+}
+
+/// What `cost` leaves of the gas, or `None` where the gas does not cover it.
+///
+/// The counter is below 2^63 in this dispatch (`run` asserts it), so the sign of the difference
+/// tells, as in `RemainingGas::spend_static`.
+#[inline(always)]
+const fn left_after(gas: RemainingGas, cost: u64) -> Option<u64> {
+    let left = gas.get().wrapping_sub(cost);
+    if (left as i64) < 0 { None } else { Some(left) }
+}
+
+/// The address of the word at `offset` of the memory, and what is left of the gas after `cost`
+/// and after what growing the memory to hold the word costs.
+///
+/// For a word at a multiple of 8 that the memory holds or can be grown to hold without a call:
+/// in the room its buffer has ([`Memory::grow_in_place`]), with the gas for it. The memory is
+/// then grown and charged for as `Memory::resize_evm` does it. `None` for anything else, with
+/// nothing changed.
+///
+/// [`Memory::grow_in_place`]: crate::interpreter::Memory::grow_in_place
+#[inline(always)]
+fn word_in_memory<T: EvmTypesHost>(
+    state: &mut InterpreterState<'_, '_, T>,
+    offset: &Word,
+    gas: RemainingGas,
+    cost: u64,
+) -> Option<(*mut u8, u64)> {
+    let [offset, o1, o2, o3] = *offset.as_limbs();
+    if (o1 | o2 | o3) != 0 || !offset.is_multiple_of(8) {
+        return None;
+    }
+    let base = state.memory().as_mut_ptr();
+    if !(base as usize).is_multiple_of(8) {
+        return None;
+    }
+    let charged = *state.gas_mut().memory();
+    let size = charged.words_num as u64 * 32;
+    let left = if size >= 32 && offset <= size - 32 {
+        left_after(gas, cost)?
+    } else {
+        let words = offset.checked_add(32)?.div_ceil(32) as usize;
+        // SAFETY: Reading the gas parameters makes no host call.
+        let total = unsafe { state.gas_params_detached() }.memory_cost(words);
+        let grown = total.checked_sub(charged.expansion_cost)?;
+        // Far above any gas there is, and far below where `left_after` could be wrong.
+        if grown > u32::MAX as u64 {
+            return None;
+        }
+        let left = left_after(gas, cost + grown)?;
+        if !state.memory().grow_in_place(words) {
+            return None;
+        }
+        let _ = state.gas_mut().memory_mut().set_words_num(words, total);
+        left
+    };
+    // SAFETY: The memory is as long as the words charged for, the word ends within them, and
+    // growing in place does not move the buffer.
+    Some((unsafe { base.add(offset as usize) }, left))
+}
+
+/// `MLOAD` of a word at a multiple of 8 in the memory, grown in place if it has to be.
+#[inline(always)]
+fn mload<T: EvmTypesHost, C: EvmConfig<T>>(
+    pc: &mut Pc,
+    stack: &mut RawStack<'_>,
+    gas: &mut RemainingGas,
+    state: &mut InterpreterState<'_, '_, T>,
+) -> Option<u8> {
+    if stack.is_empty() {
+        return None;
+    }
+    // SAFETY: The stack is not empty, and no handler has it borrowed here.
+    let top = unsafe { stack.below_top_unchecked(0) };
+    let cost = C::OPCODE_CONFIG.static_gas(op::MLOAD) as u64;
+    // SAFETY: `top` is the word on top.
+    let Some((p, left)) = word_in_memory(state, unsafe { &*top }, *gas, cost) else {
+        return None;
+    };
+    // SAFETY: 32 bytes of the memory at a multiple of 8; `top` is the word on top; the byte after
+    // an `MLOAD` is in the code or in its padding.
+    unsafe {
+        top.write(crate::utils::read_be_word_aligned(p.cast()));
+        pc.advance_unchecked(1);
+    }
+    gas.set(left);
+    Some(pc.op())
+}
+
+/// `MSTORE` of a word at a multiple of 8 in the memory, grown in place if it has to be.
+#[inline(always)]
+fn mstore<T: EvmTypesHost, C: EvmConfig<T>>(
+    pc: &mut Pc,
+    stack: &mut RawStack<'_>,
+    gas: &mut RemainingGas,
+    state: &mut InterpreterState<'_, '_, T>,
+) -> Option<u8> {
+    if !stack.has(2) {
+        return None;
+    }
+    // SAFETY: There are two words on the stack, and no handler has it borrowed here.
+    let (offset, value) =
+        unsafe { (&*stack.below_top_unchecked(0), &*stack.below_top_unchecked(1)) };
+    let cost = C::OPCODE_CONFIG.static_gas(op::MSTORE) as u64;
+    let Some((p, left)) = word_in_memory(state, offset, *gas, cost) else {
+        return None;
+    };
+    // SAFETY: 32 bytes of the memory at a multiple of 8; two words on the stack; the byte after
+    // an `MSTORE` is in the code or in its padding.
+    unsafe {
+        crate::utils::write_be_word_aligned(p.cast(), value);
+        stack.drop_unchecked(2);
+        pc.advance_unchecked(1);
+    }
+    gas.set(left);
+    Some(pc.op())
+}
+
+/// `CALLDATALOAD` of a word that lies within the call data, at a multiple of 4.
+#[inline(always)]
+fn calldataload<T: EvmTypesHost, C: EvmConfig<T>>(
+    pc: &mut Pc,
+    stack: &mut RawStack<'_>,
+    gas: &mut RemainingGas,
+    state: &mut InterpreterState<'_, '_, T>,
+) -> Option<u8> {
+    let Some(left) = left_after(*gas, C::OPCODE_CONFIG.static_gas(op::CALLDATALOAD) as u64) else {
+        return None;
+    };
+    if stack.is_empty() {
+        return None;
+    }
+    // SAFETY: The stack is not empty, and no handler has it borrowed here.
+    let top = unsafe { stack.below_top_unchecked(0) };
+    // SAFETY: `top` is the word on top.
+    let [offset, o1, o2, o3] = unsafe { *(*top).as_limbs() };
+    let input = state.input();
+    let len = input.len() as u64;
+    if (o1 | o2 | o3) != 0 || len < 32 || offset > len - 32 {
+        return None;
+    }
+    // SAFETY: The word ends within the call data.
+    let p = unsafe { input.as_ptr().add(offset as usize) };
+    // SAFETY: 32 bytes of the call data, at a multiple of 8 or of 4.
+    let word = if (p as usize).is_multiple_of(8) {
+        unsafe { crate::utils::read_be_word_aligned(p.cast()) }
+    } else if (p as usize).is_multiple_of(4) {
+        unsafe { crate::utils::read_be_word_halves(p.cast()) }
+    } else {
+        return None;
+    };
+    // SAFETY: `top` is the word on top; the byte after a `CALLDATALOAD` is in the code or in its
+    // padding.
+    unsafe {
+        top.write(word);
+        pc.advance_unchecked(1);
+    }
+    gas.set(left);
+    Some(pc.op())
+}
+
+/// The offset in the code that the word `target` names, when it is a `JUMPDEST`.
+#[inline(always)]
+fn jumpdest<T: EvmTypesHost>(state: &InterpreterState<'_, '_, T>, target: &Word) -> Option<usize> {
+    let [target, t1, t2, t3] = *target.as_limbs();
+    if (t1 | t2 | t3) != 0 {
+        return None;
+    }
+    if state.bytecode().is_valid_jumpdest(target as usize) { Some(target as usize) } else { None }
+}
+
+/// `JUMP` to a `JUMPDEST`, with gas for both: the pc is left after the `JUMPDEST`, which has
+/// nothing to do but be paid for.
+#[inline(always)]
+fn jump<T: EvmTypesHost, C: EvmConfig<T>>(
+    pc: &mut Pc,
+    stack: &mut RawStack<'_>,
+    gas: &mut RemainingGas,
+    state: &mut InterpreterState<'_, '_, T>,
+) -> Option<u8> {
+    let config = C::OPCODE_CONFIG;
+    let cost = config.static_gas(op::JUMP) as u64 + config.static_gas(op::JUMPDEST) as u64;
+    let Some(left) = left_after(*gas, cost) else {
+        return None;
+    };
+    if stack.is_empty() {
+        return None;
+    }
+    // SAFETY: The stack is not empty, and no handler has it borrowed here.
+    let Some(target) = jumpdest(state, unsafe { &*stack.below_top_unchecked(0) }) else {
+        return None;
+    };
+    // SAFETY: The stack is not empty; the byte after a `JUMPDEST` is in the code or its padding.
+    unsafe {
+        stack.drop_unchecked(1);
+        pc.set_unchecked(state.bytecode(), target + 1);
+    }
+    gas.set(left);
+    Some(pc.op())
+}
+
+/// `JUMPI`: not taken, or taken as [`jump`] is.
+#[inline(always)]
+fn jumpi<T: EvmTypesHost, C: EvmConfig<T>>(
+    pc: &mut Pc,
+    stack: &mut RawStack<'_>,
+    gas: &mut RemainingGas,
+    state: &mut InterpreterState<'_, '_, T>,
+) -> Option<u8> {
+    let config = C::OPCODE_CONFIG;
+    let cost = config.static_gas(op::JUMPI) as u64;
+    if !stack.has(2) {
+        return None;
+    }
+    // SAFETY: There are two words on the stack, and no handler has it borrowed here.
+    let (target, condition) =
+        unsafe { (&*stack.below_top_unchecked(0), &*stack.below_top_unchecked(1)) };
+    if condition.is_zero() {
+        let Some(left) = left_after(*gas, cost) else {
+            return None;
+        };
+        // SAFETY: Two words on the stack; the byte after a `JUMPI` is in the code or its padding.
+        unsafe {
+            stack.drop_unchecked(2);
+            pc.advance_unchecked(1);
+        }
+        gas.set(left);
+        return Some(pc.op());
+    }
+    let Some(left) = left_after(*gas, cost + config.static_gas(op::JUMPDEST) as u64) else {
+        return None;
+    };
+    let Some(target) = jumpdest(state, target) else {
+        return None;
+    };
+    // SAFETY: Two words on the stack; the byte after a `JUMPDEST` is in the code or its padding.
+    unsafe {
+        stack.drop_unchecked(2);
+        pc.set_unchecked(state.bytecode(), target + 1);
+    }
+    gas.set(left);
+    Some(pc.op())
+}
+
+/// `PUSH2`, and with it the `JUMP` or `JUMPI` that follows, which is how solc reaches a label.
+///
+/// As three handlers the pair is a word written to the stack and read back, the upper limbs of
+/// the target tested for zero and three dispatches, the third for the `JUMPDEST`. Here the
+/// target is the operand. The fused step is taken with gas for all of it and a target that is a
+/// `JUMPDEST`; otherwise the `PUSH2` runs alone, and the handler of the jump finds what there is
+/// to report, with the pc, the stack and the gas it always had.
+///
+/// The one difference from the separate handlers is the slot above the top, where they leave
+/// the target and the fused step leaves what was there. Nothing reads a slot above the top.
+#[inline(always)]
+fn push2<T: EvmTypesHost, C: EvmConfig<T>>(
+    pc: &mut Pc,
+    stack: &mut RawStack<'_>,
+    gas: &mut RemainingGas,
+    state: &mut InterpreterState<'_, '_, T>,
+) -> Option<u8> {
+    let config = C::OPCODE_CONFIG;
+    let push = config.static_gas(op::PUSH2) as u64;
+    if stack.is_full() {
+        return None;
+    }
+    // SAFETY: A legacy code ends with 33 bytes of zero padding, so the three bytes after a
+    // `PUSH2` opcode are in the allocation wherever the opcode is.
+    let (operand, next) = unsafe {
+        let p = pc.as_ptr();
+        ((*p.add(1) as usize) << 8 | *p.add(2) as usize, *p.add(3))
+    };
+    // `JUMP` and `JUMPI` are 0x56 and 0x57: one comparison for both.
+    if const { fuses_jumps::<T, C>() } && next & !1 == op::JUMP {
+        let landing = config.static_gas(op::JUMPDEST) as u64;
+        if next == op::JUMP {
+            let cost = push + config.static_gas(op::JUMP) as u64 + landing;
+            let Some(left) = left_after(*gas, cost) else {
+                return None;
+            };
+            if !state.bytecode().is_valid_jumpdest(operand) {
+                return None;
+            }
+            // SAFETY: The byte after a `JUMPDEST` is in the code or in its padding.
+            unsafe { pc.set_unchecked(state.bytecode(), operand + 1) };
+            gas.set(left);
+            return Some(pc.op());
+        }
+        let cost = push + config.static_gas(op::JUMPI) as u64;
+        if stack.is_empty() {
+            return None;
+        }
+        // SAFETY: The stack is not empty, and no handler has it borrowed here.
+        if unsafe { &*stack.below_top_unchecked(0) }.is_zero() {
+            let Some(left) = left_after(*gas, cost) else {
+                return None;
+            };
+            // SAFETY: The stack is not empty; `PUSH2`, its operand and the `JUMPI` are in the
+            // code, and padding follows it.
+            unsafe {
+                stack.drop_unchecked(1);
+                pc.advance_unchecked(4);
+            }
+            gas.set(left);
+            return Some(pc.op());
+        }
+        let Some(left) = left_after(*gas, cost + landing) else {
+            return None;
+        };
+        if !state.bytecode().is_valid_jumpdest(operand) {
